@{
    ViewData["Title"] = "Participant Dashboard";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Welcome, @Context.Session.GetString("FirstName")!</h1>
            <p class="text-muted">Discover your next RaceDay event.</p>
        </div>

        <a asp-controller="Auth" asp-action="Logout"
           class="btn btn-outline-danger">Logout</a>
    </div>

    <div class="card shadow-sm p-4 mb-4">
        <h3>Upcoming Events</h3>
        <p>Explore upcoming running, walking and cycling events.</p>
        <a asp-controller="Enrolments"
           asp-action="MyEvents"
           class="btn btn-outline-primary mb-3">
            My Events
        </a>
        <a asp-controller="Results"
           asp-action="MyResults"
           class="btn btn-outline-success mb-3">
            My Results
        </a>
        <a asp-controller="Profile"
           asp-action="Index"
           class="btn btn-outline-info mb-3">
            My Profile
        </a>
        <div id="eventsContainer" class="row">
            <p>Loading events...</p>
        </div>
    </div>

</div>

<script>
    async function loadEvents() {
        const container = document.getElementById("eventsContainer");

        try {
            const response = await fetch("/Events/GetEvents");

            if (!response.ok) {
                throw new Error("Unable to retrieve events.");
            }

            const events = await response.json();

            container.innerHTML = "";

            if (events.length === 0) {
                container.innerHTML = "<p>No events available yet.</p>";
                return;
            }

            events.forEach(event => {
                container.innerHTML += `
                    <div class="col-md-6 col-lg-4 mb-3">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body">
                                <h5>${event.eventName}</h5>
                                <p>${event.description ?? "No description available."}</p>
                                <p><strong>Date:</strong> ${new Date(event.eventDate).toLocaleDateString()}</p>
                                <p><strong>Location:</strong> ${event.location}</p>
                                <p><strong>Distance:</strong> ${event.distance} km</p>
                                <span class="badge bg-success">${event.eventType}</span>

                             <div class="mt-3">
                             <a href="/Events/Details/${event.eventID}"
                             class="btn btn-primary">
                              View Details & Enrol
                             </a>
                          </div>
                        </div>
                     </div>
                   </div>
                `;
            });

        } catch (error) {
            container.innerHTML =
                "<p class='text-danger'>Could not load events. Please try again.</p>";
        }
    }

    loadEvents();
</script>