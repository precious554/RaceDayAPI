@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Welcome, @Context.Session.GetString("FirstName")!</h1>
            <p class="text-muted">Manage your RaceDay sporting events.</p>
        </div>

        <a asp-controller="Auth" asp-action="Logout"
           class="btn btn-outline-danger">Logout</a>
    </div>

    <div class="card shadow-sm p-4">
        <h3>Organiser Dashboard</h3>
        <p>Welcome to your event management area.</p>

        <h5 class="mt-3">Event Management</h5>

        <p>Create, view, update and manage your sporting events.</p>

        <a asp-controller="Events"
           asp-action="Manage"
           class="btn btn-primary">
            Manage Events
        </a>

        <a href="/api/events" target="_blank" class="btn btn-primary">
            View Events API
        </a>
    </div>

</div>