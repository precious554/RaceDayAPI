@model RaceDayMVC.Models.CategoryViewModel

@{
    ViewData["Title"] = "Create Category";
}

<div class="container mt-4" style="max-width:650px;">

    <h2>Create Event Category</h2>

    <form asp-action="Create" method="post">

        <input type="hidden" asp-for="EventID" />

        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="CategoryName" class="form-label"></label>
            <input asp-for="CategoryName" class="form-control" />
            <span asp-validation-for="CategoryName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Distance" class="form-label">Distance (km)</label>
            <input asp-for="Distance" type="number" step="0.1" class="form-control" />
            <span asp-validation-for="Distance" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="EntryFee" class="form-label">Entry Fee (R)</label>
            <input asp-for="EntryFee" type="number" step="0.01" class="form-control" />
            <span asp-validation-for="EntryFee" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Create Category</button>

        <a asp-action="Manage"
           asp-route-eventId="@Model.EventID"
           class="btn btn-secondary">Cancel</a>

    </form>
</div>