@model RaceDayMVC.Models.EventViewModel

@{
    ViewData["Title"] = "Edit Event";
}

<div class="container mt-4" style="max-width:700px;">

    <h2 class="mb-4">Edit Event</h2>

    <form asp-action="Edit" asp-route-id="@Model.EventID" method="post">

        <input type="hidden" asp-for="EventID" />

        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="EventName" class="form-label">Event Name</label>
            <input asp-for="EventName" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="EventDate" class="form-label">Event Date</label>
            <input asp-for="EventDate"
                   type="datetime-local"
                   asp-format="{0:yyyy-MM-ddTHH:mm}"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Location" class="form-label"></label>
            <input asp-for="Location" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control"></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="Distance" class="form-label">Distance (km)</label>
            <input asp-for="Distance" type="number" step="0.1" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="EventType" class="form-label">Event Type</label>
            <select asp-for="EventType" class="form-select">
                <option value="Run">Run</option>
                <option value="Walk">Walk</option>
                <option value="Cycle">Cycle</option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary">Save Changes</button>

        <a asp-action="Manage" class="btn btn-secondary">Cancel</a>

    </form>
</div>