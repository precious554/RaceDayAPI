@model RaceDayMVC.Models.EventViewModel

@{
    ViewData["Title"] = "Edit Event";
}

<div class="container mt-4 mb-5" style="max-width:700px;">

    <h2 class="mb-4">Edit Event</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm p-4 mb-4">
        <h4>Event Banner</h4>

        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Url.Action("Banner", "Events", new { id = Model.EventID })"
                 alt="Event Banner"
                 class="img-fluid rounded mb-3"
                 style="max-height:250px; object-fit:cover;" />
        }
        else
        {
            <div class="alert alert-light border">
                No event banner uploaded yet.
            </div>
        }

        <p class="text-muted">
            Upload an image to make your event stand out.
        </p>

        <form asp-action="UploadBanner"
              asp-route-id="@Model.EventID"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">Choose Event Banner</label>
                <input type="file"
                       name="file"
                       class="form-control"
                       accept=".jpg,.jpeg,.png,.webp"
                       required />

                <small class="text-muted">
                    JPG, PNG or WEBP. Maximum size: 5 MB.
                </small>
            </div>

            <button type="submit" class="btn btn-success">
                Upload Banner
            </button>
        </form>
    </div>

    <div class="card shadow-sm p-4">
        <h4>Event Information</h4>

        <form asp-action="Edit"
              asp-route-id="@Model.EventID"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="EventID" />
            <input type="hidden" asp-for="ImageUrl" />

            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="EventName" class="form-label">Event Name</label>
                <input asp-for="EventName" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="EventDate" class="form-label">Event Date</label>
                <input asp-for="EventDate"
                       type="datetime-local"
                       asp-format="{0:yyyy-MM-ddTHH:mm}"
                       class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Location" class="form-label"></label>
                <input asp-for="Location" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="Distance" class="form-label">Distance (km)</label>
                <input asp-for="Distance"
                       type="number"
                       step="0.1"
                       class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="EventType" class="form-label">Event Type</label>
                <select asp-for="EventType" class="form-select">
                    <option value="Run">Run</option>
                    <option value="Walk">Walk</option>
                    <option value="Cycle">Cycle</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary">
                Save Changes
            </button>

            <a asp-action="Manage" class="btn btn-secondary">
                Cancel
            </a>

        </form>
    </div>
</div>